# Lantage inference service — environment reference.
# Copy to .env for local use. NEVER commit a filled-in copy.
#
# Two distinct groups below. Getting them confused is the most likely
# configuration mistake:
#
#   [A] DEPLOY-TIME  — read by app.py when `modal deploy` executes it on YOUR
#                      machine. They are baked into the deployed configuration.
#                      Changing one requires a redeploy.
#   [B] RUNTIME      — lives in the Modal Secret, injected into the container.
#                      Never put these in this file in real values.

# ---------------------------------------------------------------------------
# [B] RUNTIME — Modal Secret `lantage-inference`
# ---------------------------------------------------------------------------
# The only thing between a public HTTPS URL and our GPU budget. A Modal web
# endpoint is internet-reachable by design; there is no network-level gate.
# Generate with:  openssl rand -hex 32
# Create with:    modal secret create lantage-inference LANTAGE_INFERENCE_SECRET=<value>
LANTAGE_INFERENCE_SECRET=

# ---------------------------------------------------------------------------
# [A] DEPLOY-TIME — scaling and cost posture
# ---------------------------------------------------------------------------
# THE most expensive setting in the project. MASTER_PLAN §6:
#   min_containers=1  -> ~$576/mo fixed, ~$0.02-0.05 per 1,000 searches
#   min_containers=0  -> ~$0/mo idle,    ~$1.10 per 1,000 searches (20-50x worse)
# Use 1 for anything demoable. Use 0 only for pre-revenue development, where the
# fixed cost matters more than latency (§6: fixed cost falls to ~$270/mo).
LANTAGE_MIN_CONTAINERS=1

# Extra idle containers provisioned while traffic is active. 0 is right until
# real burst traffic exists; each one is another $0.80/hr.
LANTAGE_BUFFER_CONTAINERS=0

# Seconds a container stays alive after its last request. Generous on purpose:
# discarding a container means re-paying the weight load on the next burst.
# Range Modal allows is 2s to 20min.
LANTAGE_SCALEDOWN_WINDOW=300

# Ceiling on concurrent containers — the spend guardrail.
LANTAGE_MAX_CONTAINERS=4

# GPU. L4 ($0.80/hr) is the §6 choice: enough VRAM for all four models resident,
# cheapest card that clears the latency budget. A10G/A100 only if bench.py shows
# L4 missing the budget.
LANTAGE_GPU=L4

# ---------------------------------------------------------------------------
# [A] DEPLOY-TIME — throughput
# ---------------------------------------------------------------------------
# Requests interleaved per container. GPU compute is serialised behind a lock;
# what this overlaps is image fetch + decode, which is pure I/O and a real share
# of wall time. Raising it does not oversubscribe the GPU.
LANTAGE_MAX_CONCURRENT_INPUTS=8
LANTAGE_TARGET_CONCURRENT_INPUTS=4

# Images per GPU forward pass. Bounds peak VRAM.
LANTAGE_GPU_BATCH_SIZE=8

# Max images accepted by /embed_batch in one request.
LANTAGE_MAX_BATCH_IMAGES=64

# Per-request timeout, seconds. Generous for B3's bulk harvest calls.
LANTAGE_TIMEOUT=600

# ---------------------------------------------------------------------------
# [A] DEPLOY-TIME — models
# ---------------------------------------------------------------------------
# Comma-separated subset to load. Empty = all four. Trimming this cuts image
# build time and VRAM during development; production must load all four.
# Valid: geoclip,eigenplaces,dinov2,megaloc
LANTAGE_MODELS=

# EigenPlaces input size. WARNING: part of the descriptor's identity. Query and
# index MUST use the same value or recall collapses with no error. If BENCH (D1)
# picks a different size, bump the model version in MODEL_REGISTRY and rebuild
# the index — do not change this in place on a live corpus.
LANTAGE_EIGENPLACES_SIZE=512

# Name of the Modal Secret to attach.
LANTAGE_MODAL_SECRET=lantage-inference

# ---------------------------------------------------------------------------
# CLIENT SIDE — for bench.py, and for B2's orchestrator
# ---------------------------------------------------------------------------
# Printed by `modal deploy`. Shape:
#   https://<workspace>--lantage-inference-embedder-web.modal.run
LANTAGE_INFERENCE_URL=

# Optional: local path or URL to a real test frame for bench.py. Omit and bench
# generates a deterministic synthetic PNG so it runs with no assets.
LANTAGE_BENCH_IMAGE=
